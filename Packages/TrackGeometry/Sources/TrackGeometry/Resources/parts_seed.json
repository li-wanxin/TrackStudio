  "conventions": {
    "origin": "端口 a 固定在局部原点 (0,0)，主体沿 +x 延伸",
    "heading": "端口朝向 = 轨道从件内指向外的切线方向，逆时针为正，0° = +x",
    "radius": "弯轨半径一律指轨道中心线半径；内缘 = R - 20，外缘 = R + 20（轨宽 40）",
    "polarity": "M = 凸榫(公头), F = 凹槽(母口)",
    "level": "端口相对基准地面高度，0 = 地面层"
  },
